# Use MOCK for the browser simulator, BACKEND for Spring Boot, or CLOUD for Vercel/Supabase.
NEXT_PUBLIC_SMART_ESTATE_MODE=BACKEND
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Development-only. The UI also checks NODE_ENV before showing onboarding.
NEXT_PUBLIC_ENABLE_DEV_ONBOARDING=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Existing Supabase project. The anon key is public by design; never use the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only pooled transaction connection for Vercel route handlers.
DATABASE_URL=
# Server-only direct or session connection used only by reviewed migration tooling.
DIRECT_URL=

# Server-only credential shared with the outbound local IoT bridge.
IOT_GATEWAY_ID=
IOT_GATEWAY_CREDENTIAL=
