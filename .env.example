# Use MOCK to run the original in-browser simulator, or BACKEND for Spring Boot.
NEXT_PUBLIC_SMART_ESTATE_MODE=BACKEND
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Development-only. The UI also checks NODE_ENV before showing onboarding.
NEXT_PUBLIC_ENABLE_DEV_ONBOARDING=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
