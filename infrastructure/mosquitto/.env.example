# This service consumes mounted secret files, not plaintext environment values.
# Railway volume: /mosquitto/data
# Secret-file mounts or a protected init mechanism must provide:
# /run/secrets/mqtt-cert.pem
# /run/secrets/mqtt-key.pem
# /run/secrets/mqtt-ca.pem
# /run/secrets/controller-registry.json
# /run/secrets/mqtt-credentials.json
