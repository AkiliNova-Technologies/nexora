# Prefer Railway sealed variables containing single-line base64. The entrypoint
# atomically materializes them as 0600 files and unsets the variables before
# Mosquitto starts. Pre-mounted files at the paths below take precedence.
# Railway volume: /mosquitto/data
MQTT_CERT_PEM_B64=base64-of-mqtt-cert.pem
MQTT_KEY_PEM_B64=base64-of-mqtt-key.pem
MQTT_CA_PEM_B64=base64-of-mqtt-ca.pem
MQTT_CONTROLLER_REGISTRY_JSON_B64=base64-of-controller-registry.json
MQTT_CREDENTIALS_JSON_B64=base64-of-mqtt-credentials.json
