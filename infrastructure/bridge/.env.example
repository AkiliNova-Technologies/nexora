NEXORA_API_BASE_URL=https://nexora-home.vercel.app
NEXORA_GATEWAY_ID=replace-with-gateway-id
NEXORA_GATEWAY_CREDENTIAL=replace-with-secret
MQTT_URL=mqtts://nexora-mqtt.railway.internal:8883
MQTT_USERNAME=replace-with-bridge-username
MQTT_PASSWORD=replace-with-secret
MQTT_CA_FILE=/run/secrets/mqtt-ca.pem
# Required when MQTT_URL uses Railway private DNS but the certificate SAN uses
# the public controller endpoint identity.
MQTT_TLS_SERVERNAME=mqtt.example.com
BRIDGE_STORE_PATH=/data/bridge.sqlite
BRIDGE_POLL_INTERVAL_MS=3000
BRIDGE_MAX_BACKOFF_MS=30000
BRIDGE_HEALTH_PORT=8080
BRIDGE_MAX_PAYLOAD_BYTES=16384
BRIDGE_MAX_QUEUED_EVENTS=10000
BRIDGE_EVENT_RETENTION_DAYS=14
